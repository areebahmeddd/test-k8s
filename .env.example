APP_NAME="Todo API"
DEBUG=false

# SQLite by default; docker compose overrides this with its PostgreSQL service.
DATABASE_URL=sqlite+aiosqlite:///./todo.db

# Required. Generate one with: openssl rand -hex 32
SECRET_KEY=change-me-to-the-output-of-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional. Set the OTLP gRPC endpoint to enable OpenTelemetry tracing.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=todo-api
