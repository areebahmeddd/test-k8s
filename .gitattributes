# Normalize line endings of all text files to LF.
* text=auto eol=lf

# SOPS-encrypted secrets must be kept byte for byte: any change, such as LF becoming CRLF
# on a Windows checkout, breaks the SOPS MAC checksum.
k8s/overlays/*/secrets/*.yaml binary

# Leave the application, web UI and policy code out of GitHub's language statistics.
*.py linguist-detectable=false
*.js linguist-detectable=false
*.css linguist-detectable=false
*.html linguist-detectable=false
*.rego linguist-detectable=false
